.env
.venv/
# The local storage backend's default root in a source checkout: see
# core.config.data_dir. Exports and templates the app wrote, not source.
var/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
node_modules/
src/lcf/web/static/dist/
logs/
*.log
.DS_Store
# diagrams.net writes this beside the file it is editing and leaves it behind
# when the app did not shut down cleanly, so closing the diagram is not enough.
.$*.bkp
*.dtmp
