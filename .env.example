# Lancy Content Flow — configuration
#
# Copy to .env and fill in. .env is git-ignored; this file is not.
# All values are read by pydantic-settings at startup.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
LCF_HOST=0.0.0.0
LCF_PORT=8090
LCF_LOG_LEVEL=INFO
LCF_DEBUG=false

# ---------------------------------------------------------------------------
# Database  — one of the two. No default: unset means "not set up".
# ---------------------------------------------------------------------------
LCF_DB_URL=postgresql+asyncpg://USER:PASSWORD@db-host:5432/lcf
# LCF_DB_URL=sqlite+aiosqlite:////absolute/path/to/lcf.db

# ---------------------------------------------------------------------------
# LLM  (OpenAI-compatible endpoint — vLLM)
# ---------------------------------------------------------------------------
LCF_LLM_BASE_URL=http://llm-host:8000/v1
LCF_LLM_API_KEY=not-needed-for-local-vllm
LCF_LLM_MODEL=MODEL_ID_AS_SERVED

# Model properties, not constants — these change when the model changes,
# and the batching and context-budget logic reads them rather than assuming.
LCF_LLM_MAX_IMAGES_PER_CALL=4
LCF_LLM_CONTEXT_WINDOW=32768
# A ceiling, not a target. Requests stream and stop as soon as the JSON object
# closes, so a generous value costs nothing on a well-behaved reply.
LCF_LLM_MAX_TOKENS=4096
LCF_LLM_TEMPERATURE=0.2
LCF_LLM_TIMEOUT_S=180

# How many LLM calls may run at once. Size to what the host tolerates:
# the final assessment fans out across checks.
LCF_LLM_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Storage  (exports, Word templates, uploads)
# ---------------------------------------------------------------------------
# Two backends. The local disk is the default and needs no setup; an empty
# endpoint below selects it. Point this at an S3-compatible store (versitygw,
# MinIO) only when more than one machine has to read the same files.
#
# Where the local backend puts them. Empty means the application's own data
# directory: `var/` inside a source checkout, `~/.local/share/lcf` once
# installed. Ignored when an S3 endpoint is set.
LCF_STORAGE_DIR=

LCF_S3_ENDPOINT=http://storage-host:7070
LCF_S3_ACCESS_KEY=
LCF_S3_SECRET_KEY=
LCF_S3_REGION=us-east-1
LCF_S3_BUCKET_UPLOADS=lcf-uploads
LCF_S3_BUCKET_TEMPLATES=lcf-templates
LCF_S3_BUCKET_EXPORTS=lcf-exports

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# The house style: a .docx holding header, footer, logo, fonts and colours, and
# no content. Every generated starter template is built onto it, and a document
# type with no template of its own exports onto it too — so branding is set once
# here rather than reapplied to every template by hand. Leave empty for plain
# white paper. Setup can upload one instead, which takes precedence over this;
# the path is for an installation that bakes its branding into an image.
LCF_DOCX_BASE_TEMPLATE=

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------
# v1 runs the worker in-process. Set false to run a separate worker process
# against the same job table.
LCF_WORKER_IN_PROCESS=true

# ---------------------------------------------------------------------------
# The activity log
# ---------------------------------------------------------------------------
# How many rows the event log keeps. The oldest beyond this are dropped after
# each background job, which is what bounds a log nothing else bounds.
LCF_EVENT_LOG_KEEP=20000
# Keep the resolved prompt and the reply with each model call, so the admin page
# can answer "why did it write that". These are the author's material, and this
# installation has no authentication — set false and the log records what a call
# cost and nothing it said. Rotation applies either way.
LCF_LOG_PROMPTS=true

# ---------------------------------------------------------------------------
# The evidence desk
# ---------------------------------------------------------------------------
# Which parser reads a PDF. `auto` prefers docling when it is importable and
# falls back to the built-in parser without complaint when it is not; `builtin`
# never reaches for it even if installed; `docling` insists on it and refuses
# rather than silently degrading.
#
# The built-in parser is pypdf, python-docx and the standard library: no model
# weights, nothing downloaded on first use, and nothing to pre-fetch on a network
# with no egress. What it cannot do is read a scan — install docling into the
# same environment (`uv pip install docling`) when somebody has those.
LCF_INGEST_PARSER=auto

# How large a passage may be, in characters. Characters rather than tokens
# knowingly: nothing counts tokens yet, so this is set low enough that the
# approximation cannot matter.
LCF_INGEST_CHUNK_CHARS=1800

# Refuse an upload larger than this, in megabytes.
LCF_INGEST_MAX_FILE_MB=25

# The cost dial. How many passages one question may spend on the assistant: a
# case of forty passages and four questions costs at most four times this.
LCF_EXTRACT_TOP_K=6

# Seconds a single pattern may run before it is reported as too slow. The guard
# against a model-written regular expression that backtracks over megabytes of
# somebody else's text.
LCF_EXTRACT_PATTERN_TIMEOUT_S=2.0
