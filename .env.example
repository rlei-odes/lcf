# Lancy Content Flow — configuration
#
# Copy to .env and fill in. .env is git-ignored; this file is not.
# All values are read by pydantic-settings at startup.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
LCF_HOST=0.0.0.0
LCF_PORT=8090
LCF_LOG_LEVEL=INFO
LCF_DEBUG=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
LCF_DB_URL=postgresql+asyncpg://USER:PASSWORD@db-host:5432/lcf

# ---------------------------------------------------------------------------
# LLM  (OpenAI-compatible endpoint — vLLM)
# ---------------------------------------------------------------------------
LCF_LLM_BASE_URL=http://llm-host:8000/v1
LCF_LLM_API_KEY=not-needed-for-local-vllm
LCF_LLM_MODEL=MODEL_ID_AS_SERVED

# Model properties, not constants — these change when the model changes,
# and the batching and context-budget logic reads them rather than assuming.
LCF_LLM_MAX_IMAGES_PER_CALL=4
LCF_LLM_CONTEXT_WINDOW=32768
LCF_LLM_TEMPERATURE=0.2
LCF_LLM_TIMEOUT_S=180

# How many LLM calls may run at once. Size to what the host tolerates:
# the final assessment fans out across checks.
LCF_LLM_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Object storage  (S3-compatible — versitygw)
# ---------------------------------------------------------------------------
LCF_S3_ENDPOINT=http://storage-host:7070
LCF_S3_ACCESS_KEY=
LCF_S3_SECRET_KEY=
LCF_S3_REGION=us-east-1
LCF_S3_BUCKET_UPLOADS=lcf-uploads
LCF_S3_BUCKET_TEMPLATES=lcf-templates
LCF_S3_BUCKET_EXPORTS=lcf-exports

# ---------------------------------------------------------------------------
# Jobs
# ---------------------------------------------------------------------------
# v1 runs the worker in-process. Set false to run a separate worker process
# against the same job table.
LCF_WORKER_IN_PROCESS=true
